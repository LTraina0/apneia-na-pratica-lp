---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Identification from '../components/Identification.astro';
import ClinicalProcess from '../components/Comparison.astro';
import TrainingOverview from '../components/TrainingOverview.astro';
import Expert from '../components/Expert.astro';
import Guarantee from '../components/Guarantee.astro';
import Faq from '../components/Faq.astro';
import Offer from '../components/Offer.astro';
import Footer from '../components/Footer.astro';
import LeadCaptureModal from '../components/LeadCaptureModal.astro';
import { pageSections } from '../config/page-sections';
---

<Layout>
  <main id="main" tabindex="-1">
    {pageSections.hero ? <Hero /> : <h1 class="page-title-accessible">Apneia na Prática</h1>}
    <Identification />
    <ClinicalProcess />
    <TrainingOverview showBooklet={pageSections.booklet} />
    <Offer />
    <Expert />
    <Guarantee />
    <Faq />
  </main>
  <Footer />
  <LeadCaptureModal />
</Layout>

<style>
  /* Retain a page heading for assistive technology while the Hero is disabled,
     without introducing a visible replacement or reserving layout space. */
  .page-title-accessible {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
