---
import { hasPublicationValue, publication } from '../config/publication';

const enabled = hasPublicationValue(publication.checkout.url);
---

{enabled && (
  <>
    <span hidden data-publication-checkout-url={publication.checkout.url}></span>

    <script>
      import { withCheckoutAttribution } from './checkout';
      import { pushTrackingEvent } from './tracking';

      const initializeCheckoutBridge = () => {
        const checkoutSource = document.querySelector<HTMLElement>('[data-publication-checkout-url]');
        const checkoutUrl = checkoutSource?.dataset.publicationCheckoutUrl;
        if (!checkoutUrl) return;

        document.querySelectorAll<HTMLAnchorElement>('[data-lead-capture="true"]').forEach((trigger) => {
          trigger.href = withCheckoutAttribution(checkoutUrl, window.location.href);

          trigger.addEventListener('click', () => {
            pushTrackingEvent({
              event: 'cta_checkout_click',
              cta_location: trigger.dataset.ctaLocation || 'offer',
              cta_text: trigger.textContent?.trim() || 'QUERO ACESSAR AGORA',
              page_path: window.location.pathname,
            });
          });
        });
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeCheckoutBridge, { once: true });
      } else {
        initializeCheckoutBridge();
      }
    </script>
  </>
)}
