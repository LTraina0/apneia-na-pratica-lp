---
import { hasPublicationValue, publication } from '../config/publication';

interface Props {
  placement: 'head' | 'body';
}

const { placement } = Astro.props;
const enabled = hasPublicationValue(publication.tracking.gtm);
---

{enabled && placement === 'head' && (
  <script is:inline define:vars={{ gtmId: publication.tracking.gtm }}>
    (function(w,d,s,l,i){
      w[l]=w[l]||[];
      w[l].push({'gtm.start': new Date().getTime(),event:'gtm.js'});
      var f=d.getElementsByTagName(s)[0],
          j=d.createElement(s),
          dl=l!='dataLayer'?'&l='+l:'';
      j.async=true;
      j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
      f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer',gtmId);
  </script>
)}

{enabled && placement === 'body' && (
  <noscript>
    <iframe
      src={`https://www.googletagmanager.com/ns.html?id=${publication.tracking.gtm}`}
      height="0"
      width="0"
      style="display:none;visibility:hidden"
      title="Google Tag Manager"
    ></iframe>
  </noscript>
)}
