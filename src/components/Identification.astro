---
import CtaBlock from './CtaBlock.astro';

const cards = [
  {
    title: "Ronco",
    description: "O paciente pode até negar o ronco ou não perceber sua frequência, mas isso não encerra a investigação.",
    icon: "snore"
  },
  {
    title: "Sono não reparador",
    description: "Quando o paciente relata que dorme, mas não sente que descansou, isso pode merecer perguntas mais específicas.",
    icon: "moon"
  },
  {
    title: "Cansaço constante",
    description: "Nem todo cansaço é “só rotina corrida”. Em alguns casos, ele pode ser um sinal que pede mais contexto.",
    icon: "fatigue"
  },
  {
    title: "Sonolência durante o dia",
    description: "Dormir em horários impróprios ou sentir sono excessivo ao longo do dia pode indicar a necessidade de investigar melhor.",
    icon: "sun-clock"
  },
  {
    title: "Respostas que encerram cedo a anamnese",
    description: "Frases como “eu não ronco” ou “isso é normal pra mim” não devem ser tratadas automaticamente como ponto final.",
    icon: "chat-stop"
  },
  {
    title: "Informações que ainda precisam ser conectadas",
    description: "O desafio muitas vezes não é perceber um sinal isolado, mas saber como reunir as informações e decidir o próximo passo.",
    icon: "nodes"
  }
];
---

<section class="identification-section" id="identificacao">
  <div class="container text-center">
    
    <!-- Eyebrow -->
    <div class="reveal">
      <span class="eyebrow identification-eyebrow">
        VOCÊ SE IDENTIFICA?
      </span>
    </div>

    <!-- H2 -->
    <h2 class="identification-title reveal delay-1">
      Nem todo paciente chega dizendo que tem um problema de sono.
    </h2>

    <!-- Intro Text -->
    <p class="identification-intro reveal delay-2">
      Na rotina do consultório, os sinais de possível apneia nem sempre aparecem como uma queixa direta. Às vezes, o que surge são indícios soltos que parecem comuns no dia a dia — e é justamente aí que uma investigação mais criteriosa começa.
    </p>

    <!-- Grid 3x2 (6 Cards) -->
    <div class="cards-grid">
      {cards.map((card, index) => (
        <div class={`card-item reveal delay-${(index % 3) + 1}`}>
          <div class="card-icon-wrapper">
            {card.icon === "snore" && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 12h5l2-6 4 12 2-6h7" />
              </svg>
            )}
            {card.icon === "moon" && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
              </svg>
            )}
            {card.icon === "fatigue" && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="16" height="10" x="2" y="7" rx="2" ry="2" />
                <line x1="22" x2="22" y1="11" y2="13" />
                <line x1="6" x2="6" y1="10" y2="14" stroke-width="2" />
              </svg>
            )}
            {card.icon === "sun-clock" && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9" />
                <polyline points="12 6 12 12 16 14" />
              </svg>
            )}
            {card.icon === "chat-stop" && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                <line x1="9" y1="10" x2="15" y2="10" />
              </svg>
            )}
            {card.icon === "nodes" && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="6" cy="6" r="3" />
                <circle cx="18" cy="6" r="3" />
                <circle cx="12" cy="18" r="3" />
                <line x1="8.5" y1="7.5" x2="15.5" y2="7.5" />
                <line x1="7.5" y1="8.5" x2="10.5" y2="15.5" />
                <line x1="16.5" y1="8.5" x2="13.5" y2="15.5" />
              </svg>
            )}
          </div>
          <h3 class="card-title">{card.title}</h3>
          <p class="card-description">{card.description}</p>
        </div>
      ))}
    </div>

    <!-- CTA Centralizado Master Component -->
    <div class="reveal delay-3">
      <CtaBlock showPrice={false} text="QUERO APRENDER A INVESTIGAR MELHOR" href="#oferta" showIcon={false} />
    </div>

  </div>
</section>

<style>
  .identification-section {
    padding-top: clamp(40px, 5.5vw, 68px);
    padding-bottom: clamp(44px, 6vw, 76px);
    background-color: var(--bg-page);
    position: relative;
  }

  .identification-eyebrow {
    margin-bottom: 12px;
  }

  .identification-title {
    max-width: 820px;
    margin: 0 auto clamp(10px, 1.5vw, 16px);
    color: var(--color-navy-700);
  }

  .identification-intro {
    max-width: 740px;
    margin: 0 auto clamp(26px, 3.5vw, 38px);
    font-size: clamp(15px, 1.1vw, 16.5px);
    line-height: 1.55;
    color: var(--color-text-body);
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-bottom: clamp(28px, 4vw, 40px);
    text-align: center;
  }

  .card-item {
    background-color: #FFFFFF;
    border: 1px solid rgba(226, 232, 240, 0.85);
    border-radius: var(--radius-card);
    padding: clamp(22px, 2.8vw, 28px) clamp(18px, 2.2vw, 24px);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: all var(--transition-fast);
  }

  .card-item:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
    border-color: rgba(24, 181, 200, 0.35);
  }

  .card-icon-wrapper {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: linear-gradient(135deg, #F1F5F9 0%, rgba(24, 181, 200, 0.12) 100%);
    border: 1px solid rgba(24, 181, 200, 0.18);
    color: var(--color-cyan-500);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
    transition: transform var(--transition-fast);
  }

  .card-item:hover .card-icon-wrapper {
    transform: scale(1.06);
    color: var(--color-blue-600);
  }

  .card-title {
    font-size: 17.5px;
    font-weight: 700;
    color: var(--color-navy-700);
    margin-bottom: 8px;
    line-height: 1.3;
  }

  .card-description {
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .cards-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media (max-width: 680px) {
    .cards-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .card-item {
      padding: 20px 16px;
    }
  }
</style>
