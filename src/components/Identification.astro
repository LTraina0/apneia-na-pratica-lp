---
const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const cards = [
  {
    title: "Ronco",
    description: "O paciente pode até negar o ronco ou não perceber sua frequência, mas isso não encerra a investigação.",
    icon: "ronco.svg",
    iconLayout: "snore"
  },
  {
    title: "Sono não reparador",
    description: "Quando o paciente relata que dorme, mas não sente que descansou, isso pode merecer perguntas mais específicas.",
    icon: "sono-nao-reparador.svg",
    iconLayout: "compact"
  },
  {
    title: "Cansaço constante",
    description: "Nem todo cansaço é “só rotina corrida”. Em alguns casos, ele pode ser um sinal que pede mais contexto.",
    icon: "cansaco-constante.svg",
    iconLayout: "fatigue"
  },
  {
    title: "Sonolência durante o dia",
    description: "Dormir em horários impróprios ou sentir sono excessivo ao longo do dia pode indicar a necessidade de investigar melhor.",
    icon: "sonolencia-dia.svg",
    iconLayout: "compact"
  },
  {
    title: "Respostas que encerram cedo a anamnese",
    description: "O paciente pode até negar o ronco ou não perceber sua frequência, mas isso não encerra a investigação.",
    icon: "anamnese.svg",
    iconLayout: "compact"
  },
  {
    title: "Informações que ainda precisam ser conectadas",
    description: "O paciente pode até negar o ronco ou não perceber sua frequência, mas isso não encerra a investigação.",
    icon: "informacoes-conectadas.svg",
    iconLayout: "compact"
  }
];
---

<section class="identification-section" id="identificacao">
  <div class="container text-center">
    
    <!-- Eyebrow -->
    <div class="reveal">
      <span class="eyebrow identification-eyebrow">
        ISSO ACONTECE NA SUA CONSULTA?
      </span>
    </div>

    <!-- H2 -->
    <h2 class="identification-title reveal delay-1">
      Nem todo paciente chega dizendo que tem um problema de sono.
    </h2>

    <!-- Intro Text -->
    <p class="identification-intro reveal delay-2">
      Muitas vezes, os sinais aparecem de forma fragmentada durante a consulta. O desafio não é apenas perceber que algo pode estar acontecendo — é saber quais informações merecem atenção e como conectá-las.
    </p>

    <!-- Grid 3x2 (6 Cards) — Figma 208:591 -->
    <div class="cards-grid">
      {cards.map((card, index) => (
        <div class={`card-item reveal delay-${(index % 3) + 1}`}>
          <div class={`card-icon card-icon--${card.iconLayout}`} aria-hidden="true">
            <img
              src={`${baseUrl}assets/identification/${card.icon}`}
              alt=""
              loading="lazy"
              decoding="async"
            />
          </div>
          <h3 class="card-title">{card.title}</h3>
          <p class="card-description">{card.description}</p>
        </div>
      ))}
    </div>


  </div>
</section>

<style>
  .identification-section {
    padding-top: clamp(40px, 5.5vw, 68px);
    padding-bottom: clamp(44px, 6vw, 76px);
    background-color: var(--bg-page);
    position: relative;
  }

  .identification-section .container {
    padding-inline: 32px;
  }

  .identification-eyebrow {
    margin-bottom: 12px;
  }

  .identification-title {
    max-width: 820px;
    margin: 0 auto clamp(10px, 1.5vw, 16px);
    color: var(--color-navy-700);
  }

  .identification-intro {
    max-width: 740px;
    margin: 0 auto clamp(26px, 3.5vw, 38px);
    font-size: clamp(15px, 1.1vw, 16.5px);
    line-height: 1.55;
    color: var(--color-text-body);
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 18px;
    row-gap: 38.5px;
    margin-bottom: 0;
    text-align: center;
  }

  .card-item {
    width: 100%;
    max-width: 346.67px;
    height: 212px;
    justify-self: center;
    background: linear-gradient(180deg, var(--color-white) 0%, #EEF6FF 100%);
    border: 1px solid rgba(24, 181, 200, 0.3);
    border-radius: var(--radius-card);
    padding: 18px 28px;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    overflow: hidden;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
  }

  .card-item:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
    border-color: rgba(24, 181, 200, 0.35);
  }

  .card-icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    transition: transform var(--transition-fast);
  }

  .card-icon img {
    display: block;
    max-width: none;
  }

  .card-icon--snore {
    width: 18.333px;
    height: 11px;
  }

  .card-icon--snore img {
    width: 20.167px;
    height: 12.833px;
  }

  .card-icon--compact {
    width: 16.5px;
    height: 16.5px;
  }

  .card-icon--compact img {
    width: 18.333px;
    height: 18.333px;
  }

  .card-icon--fatigue,
  .card-icon--fatigue img {
    width: 22px;
    height: 22px;
  }

  .card-item:hover .card-icon {
    transform: scale(1.05);
  }

  .card-title {
    width: 100%;
    margin: 0;
    font-size: 24px;
    font-weight: 700;
    color: var(--color-navy-700);
    line-height: 1.2;
    letter-spacing: -0.48px;
    text-wrap: balance;
  }

  .card-description {
    width: 100%;
    margin: 0;
    font-size: 14px;
    line-height: 21px;
    color: var(--color-text-body);
    text-wrap: pretty;
  }

  @media (max-width: 1024px) {
    .cards-grid {
      grid-template-columns: repeat(2, minmax(0, 346.67px));
      justify-content: center;
      column-gap: 18px;
      row-gap: 24px;
    }
  }

  @media (max-width: 680px) {
    .identification-section .container {
      padding-inline: 20px;
    }

    .cards-grid {
      grid-template-columns: minmax(0, 346.67px);
      gap: 14px;
      justify-content: center;
    }

    .card-item {
      padding-inline: 28px;
    }
  }

  @media (max-width: 359px) {
    .card-item {
      height: auto;
      min-height: 212px;
      padding-block: 22px;
    }
  }
</style>
