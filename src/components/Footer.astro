---
import { getSupportHref, hasPublicationValue, publication } from '../config/publication';

const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const supportHref = getSupportHref();
const hasPrivacy = hasPublicationValue(publication.legal.privacy);
const hasTerms = hasPublicationValue(publication.legal.terms);
---

<footer class="site-footer" data-node-id="148:610" data-name="Footer - Rodapé institucional">
  <div class="footer-divider reveal reveal-line" aria-hidden="true"></div>

  <div class="footer-content">
    <img
      src={`${baseUrl}assets/logo.png`}
      alt="Apneia na Prática"
      width="132"
      height="64"
      class="footer-logo reveal reveal-scale delay-1"
      loading="lazy"
    />

    <p class="footer-copyright reveal reveal-soft delay-2">
      © 2026 Apneia na Prática. <span>Todos os direitos reservados.</span>
    </p>

    <p class="footer-disclaimer reveal reveal-soft delay-3">
      Conteúdo educacional. Sinais isolados não estabelecem diagnóstico de apneia do sono.
    </p>

    <nav class="footer-links reveal reveal-soft delay-3" aria-label="Links institucionais">
      {hasPrivacy && <a href={publication.legal.privacy}>Política de privacidade</a>}
      {hasTerms && <a href={publication.legal.terms}>Termos de uso</a>}
      {supportHref && <a href={supportHref}>Suporte</a>}
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    color: #FFFFFF;
    background: linear-gradient(180deg, #12345A 0%, #0A203D 42%, #061328 100%);
  }

  .footer-divider {
    flex: 0 0 auto;
    width: 100%;
    height: 2px;
    opacity: 0.66;
    background: linear-gradient(90deg, rgba(46, 173, 194, 0), rgba(56, 211, 229, 0.82) 50%, rgba(46, 173, 194, 0));
  }

  .footer-divider.reveal {
    opacity: 0;
    transform: scaleX(0.18);
    transform-origin: center;
    filter: none;
  }

  .footer-divider.reveal.is-visible {
    opacity: 0.66;
    transform: scaleX(1);
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 880px;
    gap: 10px;
    margin: 0 auto;
    padding: 30px 20px 34px;
  }

  .footer-logo {
    display: block;
    width: 132px;
    height: 64px;
    margin-bottom: 2px;
    object-fit: contain;
    filter: drop-shadow(0 5px 14px rgba(2, 11, 39, 0.18));
  }

  .footer-copyright,
  .footer-disclaimer,
  .footer-links {
    margin: 0;
    text-align: center;
  }

  .footer-copyright {
    color: #FFFFFF;
    font-family: var(--font-primary);
    font-size: 13.5px;
    font-weight: 700;
    line-height: 1.5;
  }

  .footer-copyright span {
    color: rgba(248, 250, 252, 0.82);
    font-weight: 500;
  }

  .footer-disclaimer {
    max-width: 660px;
    color: rgba(226, 232, 240, 0.78);
    font-family: var(--font-secondary);
    font-size: 12.5px;
    line-height: 1.5;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 0;
    color: rgba(226, 232, 240, 0.7);
    font-family: var(--font-secondary);
    font-size: 11.5px;
    line-height: 1.4;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    color: #FFFFFF;
    text-decoration: underline;
  }

  .footer-links a + a::before {
    content: '';
    width: 3px;
    height: 3px;
    margin: 0 10px;
    background: rgba(56, 211, 229, 0.54);
    border-radius: 50%;
  }

  @media (max-width: 767px) {
    .footer-divider {
      height: 2px;
      opacity: 0.7;
    }

    .footer-content {
      width: calc(100% - 36px);
      max-width: 390px;
      gap: 9px;
      padding: 24px 0 28px;
    }

    .footer-logo {
      width: 116px;
      height: 56px;
    }

    .footer-copyright {
      font-size: 12px;
    }

    .footer-disclaimer {
      max-width: 330px;
      font-size: 11.5px;
    }

    .footer-links {
      max-width: 340px;
      font-size: 10.75px;
    }

    .footer-links a + a::before {
      margin: 0 8px;
    }
  }
</style>
