---
const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<footer class="site-footer" data-node-id="148:610" data-name="Footer - Rodapé institucional">
  <div class="footer-divider reveal reveal-line" aria-hidden="true"></div>

  <div class="footer-content">
    <img
      src={`${baseUrl}assets/logo.png`}
      alt="Apneia na Prática"
      width="132"
      height="64"
      class="footer-logo reveal reveal-scale delay-1"
      loading="lazy"
    />

    <p class="footer-copyright reveal reveal-soft delay-2">
      © 2026 Nome da Empresa. <span>Todos os direitos reservados.</span>
    </p>

    <p class="footer-contact reveal reveal-soft delay-3">
      Nome do Profissional - Área de Atuação - contato@email.com.br
    </p>
  </div>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    min-height: 175.1px;
    gap: 20px;
    color: #FFFFFF;
    background: #050A18;
  }

  .footer-divider {
    flex: 0 0 auto;
    width: 100%;
    height: 3px;
    opacity: 0.7;
    background: linear-gradient(90deg, rgba(46, 173, 194, 0), #2EADC2 50%, rgba(46, 173, 194, 0));
  }

  .footer-divider.reveal {
    opacity: 0;
    transform: scaleX(0.18);
    transform-origin: center;
    filter: none;
  }

  .footer-divider.reveal.is-visible {
    opacity: 0.7;
    transform: scaleX(1);
  }

  .footer-content {
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    gap: 8px;
    padding: 12px 12px 20px;
  }

  .footer-logo {
    display: block;
    width: 132px;
    height: 64.1px;
    object-fit: contain;
    filter: drop-shadow(0 2.03px 6.09px rgba(12, 38, 88, 0.05));
  }

  .footer-copyright,
  .footer-contact {
    margin: 0;
    text-align: center;
  }

  .footer-copyright {
    color: #FFFFFF;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 14.4px;
    font-weight: 700;
    line-height: 22.32px;
    white-space: nowrap;
  }

  .footer-copyright span {
    text-decoration: underline;
    text-underline-position: from-font;
    text-decoration-skip-ink: none;
  }

  .footer-contact {
    width: 100%;
    color: rgba(226, 232, 240, 0.85);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 13.76px;
    font-weight: 400;
    line-height: normal;
  }

  @media (max-width: 767px) {
    .site-footer {
      min-height: 158.7px;
      gap: 10px;
    }

    .footer-divider {
      height: 2.5px;
      opacity: 0.76;
    }

    .footer-content {
      width: calc(100% - 44px);
      max-width: 346px;
      margin: 0 auto;
      gap: 7.1px;
      padding: 6px 17.74px 20px;
    }

    .footer-logo {
      width: 115.33px;
      height: 56.01px;
      filter: drop-shadow(0 1.77px 5.32px rgba(12, 38, 88, 0.05));
    }

    .footer-copyright {
      font-size: 12.42px;
      line-height: 19.8px;
    }

    .footer-contact {
      max-width: 310.51px;
      font-size: 12.21px;
      line-height: normal;
    }
  }
</style>
