---
interface AccordionItem {
  label: string;
  title: string;
  description: string;
}

interface Props {
  items: AccordionItem[];
  name?: string;
}

const { items, name = 'training-content' } = Astro.props;
---

<div class="training-accordion" data-training-accordion>
  {items.map((item, index) => (
    <details class="training-accordion-item" name={name} open={index === 0}>
      <summary>
        <span class="lesson-index">{String(index + 1).padStart(2, '0')}</span>
        <span class="lesson-heading">
          <span class="lesson-label">{item.label}</span>
          <span class="lesson-title">{item.title}</span>
        </span>
        <span class="lesson-toggle" aria-hidden="true"></span>
      </summary>
      <div class="lesson-panel">
        <p>{item.description}</p>
      </div>
    </details>
  ))}
</div>

<style>
  .training-accordion {
    width: 100%;
    border-top: 1px solid var(--border-subtle);
  }

  .training-accordion-item {
    border-bottom: 1px solid var(--border-subtle);
  }

  summary {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) 32px;
    align-items: center;
    gap: 16px;
    min-height: 88px;
    padding: 18px 4px;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline: 3px solid rgba(24, 181, 200, 0.45);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  .lesson-index {
    font-family: var(--font-primary);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--color-cyan-500);
  }

  .lesson-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 5px;
    min-width: 0;
    font-family: var(--font-primary);
  }

  .lesson-label,
  .lesson-title {
    font-size: clamp(16px, 1.7vw, 19px);
    line-height: 1.35;
  }

  .lesson-label {
    font-weight: 800;
    color: var(--color-navy-700);
  }

  .lesson-title {
    font-weight: 600;
    color: var(--color-blue-600);
  }

  .lesson-toggle {
    position: relative;
    width: 30px;
    height: 30px;
    border: 1px solid rgba(24, 181, 200, 0.34);
    border-radius: 50%;
    background: var(--badge-cyan-gradient);
    transition: transform var(--transition-fast), background-color var(--transition-fast);
  }

  .lesson-toggle::before,
  .lesson-toggle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 10px;
    height: 2px;
    background: var(--color-teal-600);
    border-radius: 999px;
    transform: translate(-50%, -50%);
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }

  .lesson-toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  details[open] .lesson-toggle {
    transform: rotate(180deg);
    background: rgba(24, 181, 200, 0.15);
  }

  details[open] .lesson-toggle::after {
    opacity: 0;
  }

  .lesson-panel {
    padding: 0 54px 24px 58px;
  }

  .lesson-panel p {
    max-width: 680px;
    color: var(--color-text-muted);
  }

  @media (hover: hover) and (pointer: fine) {
    summary:hover .lesson-title {
      color: var(--color-teal-600);
    }

    summary:hover .lesson-toggle {
      border-color: var(--color-cyan-500);
    }
  }

  @media (max-width: 560px) {
    summary {
      grid-template-columns: 32px minmax(0, 1fr) 28px;
      gap: 10px;
      min-height: 82px;
      padding: 16px 0;
    }

    .lesson-heading {
      display: block;
    }

    .lesson-label,
    .lesson-title {
      display: block;
      font-size: 15px;
    }

    .lesson-title {
      margin-top: 2px;
    }

    .lesson-toggle {
      width: 28px;
      height: 28px;
    }

    .lesson-panel {
      padding: 0 38px 22px 42px;
    }

    .lesson-panel p {
      font-size: 14px;
    }
  }
</style>
