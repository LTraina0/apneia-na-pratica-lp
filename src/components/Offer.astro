---
import CtaBlock from './CtaBlock.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section class="offer-section scene-transition" id="oferta" data-node-id="147:526" data-name="section#oferta">
  <div class="offer-divider reveal reveal-line" aria-hidden="true"></div>
  <div class="offer-glow offer-glow-top" aria-hidden="true"></div>
  <div class="offer-glow offer-glow-bottom" aria-hidden="true"></div>

  <article class="offer-card" data-node-id="208:463" data-name="div.card-product-responsive">
    <span class="offer-badge reveal reveal-soft delay-1">Acesso Imediato</span>

    <header class="offer-brand reveal reveal-soft delay-2">
      <h2>APNEIA NA PRÁTICA</h2>
      <p>Treinamento + cartilha prática</p>
    </header>

    <div class="offer-mockup-frame reveal reveal-scale delay-3" data-node-id="147:538">
      <img
        src={`${baseUrl}assets/product-mockup.png`}
        alt="Treinamento Apneia na Prática exibido em notebook, tablet e smartphone"
        width="496"
        height="372"
        loading="lazy"
      />
    </div>

    <div class="offer-description reveal reveal-soft delay-4">
      <h3>Um treinamento direto ao ponto para levar mais critério à investigação durante a consulta.</h3>
      <p class="offer-details offer-details-desktop">
        Você vai aprender a reconhecer sinais de possível apneia, conduzir perguntas mais direcionadas e organizar melhor as informações antes de decidir quando a investigação merece avançar.
      </p>
      <p class="offer-details offer-details-mobile">
        Você vai aprender a reconhecer sinais de apneia, fazer perguntas e organizar informações antes de avançar na investigação.
      </p>
    </div>

    <CtaBlock
      showPrice={true}
      text="QUERO ACESSAR AGORA"
      href="https://pay.hotmart.com"
      target="_blank"
      leadCapture={true}
      showIcon={true}
      microcopy="Pagamento 100% seguro processado via Hotmart. Seus dados estão protegidos."
      className="offer-figma-cta reveal reveal-cta delay-5"
    />
  </article>
</section>

<style>
  .offer-section {
    position: relative;
    display: flex;
    justify-content: center;
    min-height: 1234px;
    padding: 142.5px 20px 131px;
    overflow: hidden;
    background: linear-gradient(180deg, #F8FBFD 0%, #EEF6FF 48%, #F4F8FB 100%);
  }


  .offer-divider {
    position: absolute;
    top: 0;
    left: 50%;
    width: min(1919px, 100%);
    height: 2.5px;
    transform: translateX(-50%);
    opacity: 0.7;
    background: linear-gradient(90deg, rgba(46, 173, 194, 0), #2EADC2 50%, rgba(46, 173, 194, 0));
  }

  .offer-divider.reveal {
    opacity: 0;
    transform: scaleX(0.18);
    transform-origin: center;
    filter: none;
  }

  .offer-divider.reveal.is-visible {
    opacity: 0.7;
    transform: scaleX(1);
  }

  .offer-glow {
    display: none;
    position: absolute;
    pointer-events: none;
    border-radius: 9999px;
    background: rgba(24, 181, 200, 0.12);
  }

  .offer-glow-top {
    top: -533px;
    left: 50%;
    width: 1292px;
    height: 1066px;
    transform: translateX(-50%);
    filter: blur(287.717px);
  }

  .offer-section.is-visible .offer-glow-top {
    animation: offer-breathe 7s ease-in-out 1.1s infinite;
  }

  .offer-glow-bottom {
    top: 1999px;
    left: -80px;
    width: 1252px;
    height: 803px;
    filter: blur(300px);
  }

  @keyframes offer-breathe {
    0%, 100% {
      opacity: 0.78;
      transform: translateX(-50%) scale(0.98);
    }
    50% {
      opacity: 1;
      transform: translateX(-50%) scale(1.035);
    }
  }

  .offer-card {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(724px, 100%);
    min-height: 976.304px;
    padding: 40px;
    gap: 12px;
    color: #1E293B;
    text-align: center;
    background: linear-gradient(180deg, #FFFFFF 0%, #EEF6FF 100%);
    border: 1px solid rgba(24, 181, 200, 0.3);
    border-radius: 22px;
    box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05), 0 2px 6px -1px rgba(15, 23, 42, 0.03);
  }

  .offer-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 27.48px;
    padding: 6.23px 14.54px;
    margin-bottom: 8px;
    color: #0982A2;
    font-family: var(--font-primary);
    font-size: 11.07px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.9825px;
    text-transform: uppercase;
    white-space: nowrap;
    background: linear-gradient(130deg, rgba(24, 181, 200, 0.14), rgba(33, 120, 159, 0.08));
    border: 1px solid rgba(24, 181, 200, 0.22);
    border-radius: 9999px;
  }

  .offer-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 4px 20px;
  }

  .offer-brand h2 {
    margin: 0;
    color: #0C2658;
    font-family: var(--font-primary);
    font-size: 34.29px;
    font-weight: 800;
    line-height: normal;
    letter-spacing: -1.37px;
    white-space: nowrap;
  }

  .offer-brand p {
    margin: 0;
    color: #64748B;
    font-family: var(--font-secondary);
    font-size: 21.95px;
    line-height: normal;
  }

  .offer-mockup-frame {
    position: relative;
    flex: 0 0 auto;
    width: min(490px, 100%);
    aspect-ratio: 490 / 313;
    overflow: hidden;
    border-radius: 11.33px;
  }

  .offer-mockup-frame img {
    position: absolute;
    top: -14.12%;
    left: -6.7%;
    width: 106.71%;
    height: 124.99%;
    max-width: none;
    object-fit: cover;
  }

  .offer-description {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    gap: 8px;
    padding: 12px;
  }

  .offer-description h3 {
    width: 100%;
    margin: 0;
    color: #0C2658;
    font-family: var(--font-primary);
    font-size: 31px;
    font-weight: 700;
    line-height: 36px;
    letter-spacing: -0.76px;
    text-align: center;
  }

  .offer-details {
    width: 100%;
    max-width: 600px;
    margin: 0;
    padding: 0;
    color: #1E293B;
    font-family: var(--font-secondary);
    font-size: 17px;
    line-height: 22px;
    text-align: center;
  }

  .offer-details-mobile {
    display: none;
  }

  :global(.offer-figma-cta) {
    width: 449.71px !important;
    max-width: 100% !important;
    padding: 12.5px 20.84px !important;
    gap: 12.5px !important;
  }

  :global(.offer-figma-cta .cta-inner-wrapper) {
    width: 100% !important;
    max-width: 432.37px !important;
    gap: 17.72px !important;
  }

  :global(.offer-figma-cta .master-btn) {
    width: 100% !important;
    min-height: 80px !important;
    padding: 18.46px 46.16px !important;
    border-radius: 7.09px !important;
  }

  :global(.offer-figma-cta .master-btn-content) {
    gap: 12.48px !important;
  }

  :global(.offer-figma-cta .master-hand-icon) {
    width: 26.13px !important;
    height: 31.19px !important;
  }

  :global(.offer-figma-cta .master-btn-text) {
    font-size: 20.27px !important;
    line-height: 21.05px !important;
  }

  :global(.offer-figma-cta .cta-microcopy) {
    font-size: 13.29px !important;
    line-height: 16.13px !important;
  }

  @media (max-width: 767px) {
    .offer-section {
      min-height: 825px;
      padding: 84px 20px 84.41px;
    }

    .offer-divider {
      width: 100%;
      opacity: 0.76;
    }

    .offer-glow-top {
      top: -243.64px;
      width: 944px;
      height: 468px;
      background: rgba(24, 181, 200, 0.12);
    }

    .offer-glow-bottom {
      display: none;
    }

    .offer-card {
      width: min(402px, 100%);
      min-height: 698.592px;
      padding: 20px 40px;
      gap: 12px;
      border-color: rgba(24, 181, 200, 0.3);
      border-radius: 22px;
    }

    .offer-badge {
      min-height: 21.39px;
      padding: 4.865px 11.351px;
      margin-top: 0;
      margin-bottom: 7.805px;
      font-size: 8.639px;
      letter-spacing: 0.7669px;
      border-width: 0.785px;
    }

    .offer-brand {
      gap: 3.17px;
      padding: 3.17px 15.83px;
    }

    .offer-brand h2 {
      font-size: 27.143px;
      letter-spacing: -1.0857px;
    }

    .offer-brand p {
      font-size: 17.371px;
    }

    .offer-mockup-frame {
      width: 100%;
      max-width: 322px;
      aspect-ratio: 322 / 206;
      border-radius: 7.78px;
    }

    .offer-description {
      gap: 8px;
      padding: 0;
    }

    .offer-description h3 {
      font-size: 23px;
      line-height: 26px;
      letter-spacing: -0.76px;
    }

    .offer-details-desktop {
      display: none;
    }

    .offer-details-mobile {
      display: block;
      max-width: none;
      font-size: 14px;
      line-height: 17px;
      letter-spacing: -0.14px;
    }

    :global(.offer-figma-cta) {
      width: 291.33px !important;
      padding: 8.09px 13.48px 5.77px !important;
      gap: 8.09px !important;
    }

    :global(.offer-figma-cta .price-anchor) {
      font-size: 13.75px !important;
      line-height: 22px !important;
    }

    :global(.offer-figma-cta .price-green) {
      font-size: 24px !important;
      line-height: 22px !important;
    }

    :global(.offer-figma-cta .cta-inner-wrapper) {
      max-width: 279.6px !important;
      gap: 7.1px !important;
    }

    :global(.offer-figma-cta .master-btn) {
      min-height: 44px !important;
      padding: 7.72px 19.3px !important;
      border-radius: 4.58px !important;
    }

    :global(.offer-figma-cta .master-btn-content) {
      gap: 8.07px !important;
    }

    :global(.offer-figma-cta .master-hand-icon) {
      width: 16.9px !important;
      height: 20.17px !important;
    }

    :global(.offer-figma-cta .master-btn-text) {
      font-size: 13.11px !important;
      line-height: 13.61px !important;
      white-space: nowrap;
    }

    :global(.offer-figma-cta .cta-microcopy) {
      font-size: 8.59px !important;
      line-height: 10.43px !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .offer-glow-top {
      animation: none !important;
      transform: translateX(-50%);
    }
  }
</style>
