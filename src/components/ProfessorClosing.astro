---
---

<section class="professor-closing-section" id="especialista">
  <div class="container">
    
    <!-- Bloco do Professor -->
    <div class="professor-grid">
      
      <!-- Foto do Professor: Placeholder Estrutural Neutro (Proporção 4:5) -->
      <div class="professor-photo-wrapper reveal">
        <div class="professor-photo-placeholder" role="img" aria-label="Prof. Dr. Eduardo Rollo - Instrutor do treinamento">
          <div class="placeholder-graphic">
            <svg width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="silhouette-icon">
              <circle cx="12" cy="8" r="5" />
              <path d="M20 21a8 8 0 0 0-16 0" />
            </svg>
            <span class="placeholder-tag">Prof. Dr. Eduardo Rollo</span>
          </div>
        </div>
      </div>

      <!-- Copy do Professor -->
      <div class="professor-bio reveal delay-1">
        <div class="eyebrow-wrapper">
          <span class="eyebrow professor-eyebrow">
            QUEM CONDUZ O TREINAMENTO
          </span>
        </div>

        <h2 class="professor-name">
          Prof. Dr. Eduardo Rollo
        </h2>

        <p class="bio-text">
          Eduardo Rollo conduz o treinamento com foco na investigação de possíveis sinais de apneia aplicada ao contexto clínico.
        </p>

        <p class="bio-text">
          Ao longo da aula, você entende como perguntas de anamnese, observação clínica, ferramentas de apoio e encaminhamento podem ser organizados dentro de um raciocínio mais estruturado para a rotina do consultório.
        </p>
      </div>

    </div>

    <!-- Trust Bar: 3 Cards Clean White -->
    <div class="trust-bar">
      
      <!-- Card 1: Garantia -->
      <div class="trust-card reveal delay-1">
        <div class="trust-icon-box">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            <path d="m9 12 2 2 4-4" />
          </svg>
        </div>
        <h3 class="trust-title">7 dias de garantia</h3>
        <p class="trust-desc">
          Você tem <strong>7 dias para acessar o treinamento e avaliar o conteúdo</strong>. Se decidir que ele não é para você, poderá solicitar o reembolso dentro do prazo da garantia.
        </p>
      </div>

      <!-- Card 2: Pagamento Seguro -->
      <div class="trust-card reveal delay-2">
        <div class="trust-icon-box">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
        </div>
        <h3 class="trust-title">Pagamento seguro</h3>
        <p class="trust-desc">
          Sua compra é processada pela Hotmart em ambiente protegido.
        </p>
      </div>

      <!-- Card 3: Suporte -->
      <div class="trust-card reveal delay-3">
        <div class="trust-icon-box">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10" />
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" />
            <line x1="12" y1="17" x2="12.01" y2="17" />
          </svg>
        </div>
        <h3 class="trust-title">Precisa de ajuda?</h3>
        <p class="trust-desc">
          Ficou com alguma dúvida sobre pagamento ou acesso ao treinamento? Entre em contato com nossa equipe de suporte.
        </p>
      </div>

    </div>

    <!-- Bloco de Fechamento Final com Mockup Oficial Integrado -->
    <div class="closing-card text-center reveal delay-2">
      <div class="closing-ambient-light" aria-hidden="true"></div>
      
      <h2 class="closing-heading">
        Comece a reconhecer possíveis sinais de apneia com mais critério na sua consulta.
      </h2>

      <div class="closing-product-info">
        <span class="closing-product-name">Apneia na Prática</span>
        <span class="closing-product-desc">Treinamento + cartilha prática para uso no consultório.</span>
      </div>

      <!-- Imagem do Mockup Oficial do Produto -->
      <div class="closing-mockup-wrapper">
        <img 
          src="/assets/mockup.png" 
          alt="Mockup do treinamento Apneia na Prática em notebook, tablet e smartphone" 
          width="420" 
          height="278" 
          class="closing-mockup-img"
          loading="lazy"
        />
      </div>

      <div class="closing-price-tag">
        R$ 47,00
      </div>

      <div class="closing-cta-wrapper">
        <a href="https://pay.hotmart.com" target="_blank" rel="noopener noreferrer" class="btn-primary closing-cta">
          QUERO ACESSAR AGORA
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  .professor-closing-section {
    padding-top: clamp(48px, 6vw, 76px);
    padding-bottom: clamp(56px, 7vw, 88px);
    background-color: var(--bg-surface);
    color: var(--color-text-dark);
    position: relative;
    border-top: 1px solid var(--border-subtle);
  }

  /* Bloco do Professor */
  .professor-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(32px, 4.5vw, 56px);
    align-items: center;
    margin-bottom: clamp(48px, 6vw, 72px);
  }

  .professor-photo-wrapper {
    display: flex;
    justify-content: center;
  }

  .professor-photo-placeholder {
    width: 100%;
    max-width: 320px;
    aspect-ratio: 4 / 5;
    background: linear-gradient(145deg, #EEF3F8 0%, #DCE6F0 100%);
    border: 2px solid rgba(24, 181, 200, 0.35);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .placeholder-graphic {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    color: var(--color-blue-600);
    padding: 20px;
    text-align: center;
  }

  .silhouette-icon {
    opacity: 0.75;
    color: var(--color-teal-600);
  }

  .placeholder-tag {
    font-family: var(--font-primary);
    font-size: 13px;
    font-weight: 700;
    color: var(--color-navy-700);
    background: rgba(255, 255, 255, 0.95);
    padding: 6px 14px;
    border-radius: 8px;
    border: 1px solid var(--border-subtle);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
  }

  .professor-bio {
    display: flex;
    flex-direction: column;
  }

  .eyebrow-wrapper {
    margin-bottom: 10px;
  }

  .professor-name {
    color: var(--color-navy-700);
    margin-bottom: 16px;
  }

  .bio-text {
    font-size: clamp(15px, 1.1vw, 16.5px);
    line-height: 1.6;
    color: var(--color-text-body);
    margin-bottom: 12px;
  }

  .bio-text:last-of-type {
    margin-bottom: 0;
  }

  /* Trust Bar */
  .trust-bar {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: clamp(48px, 6vw, 72px);
  }

  .trust-card {
    background-color: var(--bg-page);
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: var(--radius-card);
    padding: clamp(24px, 3vw, 30px) clamp(18px, 2.2vw, 24px);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    transition: all var(--transition-fast);
  }

  .trust-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
    border-color: rgba(24, 181, 200, 0.35);
  }

  .trust-icon-box {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: linear-gradient(135deg, #F1F5F9 0%, rgba(24, 181, 200, 0.12) 100%);
    border: 1px solid rgba(24, 181, 200, 0.18);
    color: var(--color-cyan-500);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
  }

  .trust-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--color-navy-700);
    margin-bottom: 8px;
  }

  .trust-desc {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .trust-desc strong {
    color: var(--color-navy-700);
  }

  /* Bloco de Fechamento */
  .closing-card {
    background: radial-gradient(circle at 50% 20%, rgba(24, 181, 200, 0.2) 0%, transparent 60%),
                linear-gradient(165deg, #0C2658 0%, #06183A 60%, #041141 100%);
    border-radius: var(--radius-lg);
    padding: clamp(36px, 5vw, 56px) clamp(20px, 3.5vw, 48px);
    color: var(--color-white);
    max-width: 860px;
    margin: 0 auto;
    box-shadow: 0 20px 48px rgba(12, 38, 88, 0.25);
    border: 1px solid rgba(24, 181, 200, 0.35);
    position: relative;
    overflow: hidden;
  }

  .closing-ambient-light {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60%;
    height: 120px;
    background: radial-gradient(ellipse at top, rgba(24, 181, 200, 0.25) 0%, transparent 70%);
    pointer-events: none;
  }

  .closing-heading {
    color: var(--color-white);
    font-size: clamp(24px, 3vw, 34px);
    line-height: 1.2;
    max-width: 700px;
    margin: 0 auto 16px;
  }

  .closing-product-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin-bottom: 20px;
  }

  .closing-product-name {
    font-family: var(--font-primary);
    font-size: 18px;
    font-weight: 800;
    color: var(--color-cyan-400);
  }

  .closing-product-desc {
    font-size: 14.5px;
    color: #E2E8F0;
  }

  /* Mockup no Fechamento */
  .closing-mockup-wrapper {
    max-width: 380px;
    margin: 0 auto 20px;
    display: flex;
    justify-content: center;
  }

  .closing-mockup-img {
    width: 100%;
    max-width: 360px;
    height: auto;
    display: block;
    object-fit: contain;
    filter: drop-shadow(0 12px 28px rgba(0, 0, 0, 0.35));
    transition: transform var(--transition-smooth);
  }

  .closing-mockup-img:hover {
    transform: translateY(-3px) scale(1.02);
  }

  .closing-price-tag {
    font-family: var(--font-primary);
    font-size: clamp(38px, 4.2vw, 48px);
    font-weight: 800;
    color: var(--color-white);
    margin-bottom: 20px;
    line-height: 1;
  }

  .closing-cta-wrapper {
    display: flex;
    justify-content: center;
  }

  .closing-cta {
    width: 100%;
    max-width: 360px;
  }

  @media (max-width: 900px) {
    .professor-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .trust-bar {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }

  @media (max-width: 600px) {
    .closing-cta {
      max-width: 100%;
    }
  }
</style>
