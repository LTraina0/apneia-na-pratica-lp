---
import CtaBlock from './CtaBlock.astro';
const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section class="hero-section" id="inicio" data-node-id="129:10" data-name="section#inicio">
  <!-- Camada de Fundo Sutil Clínico -->
  <div class="hero-bg-layer" style={`background-image: url('${baseUrl}assets/hero-bg.jpg');`} aria-hidden="true" data-node-id="129:12" data-name="Camada de Fundo Sutil Clínico:mask-group"></div>

  <div class="container hero-container" data-node-id="129:19" data-name="div.container">
    
    <!-- Logo Real Oficial -->
    <div class="logo-wrapper reveal delay-1" data-node-id="129:22" data-name="Logo Real Oficial">
      <div class="brand-logo-frame" data-node-id="129:23" data-name="Apneia na Prática">
        <img 
          src={`${baseUrl}assets/logo.png`} 
          alt="Apneia na Prática" 
          width="154" 
          height="75" 
          class="brand-logo"
          loading="eager"
        />
      </div>
    </div>

    <!-- Headline e Subheadline (Frame 4211) -->
    <div class="hero-text-frame reveal delay-2" data-node-id="133:1306">
      <h1 class="hero-title" data-node-id="133:1307">
        <span class="hero-title-line">Reconheça sinais de possível apneia antes que</span>
        <span class="hero-title-line">passem despercebidos na consulta.</span>
      </h1>

      <p class="hero-subtitle" data-node-id="133:1308">
        <span class="subtitle-text">Aprenda o que perguntar, o que observar e como organizar melhor as informações para entender quando a investigação do sono merece avançar. </span>
        <strong class="subtitle-bold">Treinamento para dentistas por R$ 47,00, com cartilha prática para uso no consultório.</strong>
      </p>
    </div>

    <!-- Mockup Real Oficial -->
    <div class="mockup-wrapper reveal delay-3" data-node-id="129:48" data-name="Mockup Real Oficial">
      <div class="mockup-ambient-glow" aria-hidden="true" data-node-id="129:50" data-name="div.mockup-ambient-glow"></div>
      <div class="mockup-image-frame" data-node-id="129:53" data-name="Mockup do treinamento Apneia na Prática exibido em notebook, tablet e smartphone">
        <img 
          src={`${baseUrl}assets/mockup.png`} 
          alt="Mockup do treinamento Apneia na Prática exibido em notebook, tablet e smartphone" 
          width="520" 
          height="345" 
          class="hero-mockup"
          loading="eager"
        />
      </div>
    </div>

    <!-- Bloco de Preço e CTA Master (Container 136:2 / 136:3) -->
    <div class="reveal delay-4">
      <CtaBlock
        showPrice={true}
        text="QUERO ACESSAR O TREINAMENTO"
        href="#oferta"
        showIcon={true}
        microcopy="Acesso pela Hotmart • 7 dias de garantia"
      />
    </div>

  </div>
</section>

<style>
  .hero-section {
    padding-top: 40px;
    padding-bottom: 60px;
    position: relative;
    overflow: hidden;
    background-color: var(--bg-page);
    width: 100%;
  }

  .hero-bg-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-position: center top;
    background-size: cover;
    background-repeat: no-repeat;
    opacity: 0.6;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.75) 65%, rgba(0, 0, 0, 0) 100%);
    -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.75) 65%, rgba(0, 0, 0, 0) 100%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 1200px;
    padding-left: 32px;
    padding-right: 32px;
    gap: 16px;
  }

  /* Logo */
  .logo-wrapper {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    height: 74.77px;
    width: 100%;
  }

  .brand-logo-frame {
    max-width: 154px;
    aspect-ratio: 154 / 74.77;
    filter: drop-shadow(0px 2px 6px rgba(12, 38, 88, 0.05));
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Text Frame 4211 */
  .hero-text-frame {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    max-width: 1100px;
    width: 100%;
    padding: 12px 20px;
  }

  .hero-title {
    font-family: var(--font-primary);
    font-weight: 700;
    font-size: 42px;
    line-height: 50px;
    letter-spacing: -0.9px;
    color: var(--primary-dark);
    margin: 0;
    max-width: 1040px;
  }

  .hero-title-line {
    display: block;
  }

  .hero-subtitle {
    font-family: var(--font-secondary);
    font-size: 19.5px;
    line-height: 29px;
    letter-spacing: -0.3px;
    color: #1E293B;
    margin: 0;
    max-width: 960px;
    text-wrap: balance;
  }

  .subtitle-bold {
    font-family: var(--font-primary);
    font-weight: 700;
    color: var(--primary-dark);
  }

  /* Mockup Real Oficial */
  .mockup-wrapper {
    max-width: 540px;
    width: 100%;
    padding-top: 10px;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    position: relative;
  }

  .mockup-ambient-glow {
    position: absolute;
    inset: 18.76% 5% 14.34% 5%;
    background: radial-gradient(ellipse at center, rgba(24, 181, 200, 0.16) 0%, rgba(33, 120, 159, 0.05) 50%, rgba(33, 120, 159, 0) 80%);
    filter: blur(12px);
    pointer-events: none;
    z-index: 0;
  }

  .mockup-image-frame {
    max-width: 520px;
    width: 100%;
    aspect-ratio: 520 / 345.47;
    filter: drop-shadow(0px 14px 32px rgba(12, 38, 88, 0.12));
    position: relative;
    z-index: 1;
    transition: transform var(--transition-smooth);
  }

  .mockup-image-frame:hover {
    transform: translateY(-2px) scale(1.01);
  }

  .hero-mockup {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  /* Mobile Overrides */
  @media (max-width: 767px) {
    .hero-section {
      padding-top: 28px;
      padding-bottom: 20px;
    }

    .hero-container {
      padding-left: 20px;
      padding-right: 20px;
      gap: 12px;
    }

    .logo-wrapper {
      height: 63.13px;
    }

    .brand-logo-frame {
      max-width: 130px;
      aspect-ratio: 130 / 63.13;
    }

    .hero-text-frame {
      padding: 12px 0;
      gap: 16px;
      width: 100%;
    }

    .hero-title {
      font-size: 30px;
      line-height: 33px;
      letter-spacing: -0.75px;
      color: #0C2658;
    }

    .hero-title-line {
      display: inline;
    }

    .hero-title-line:first-child {
      display: block;
    }

    .hero-subtitle {
      font-size: 16px;
      line-height: 19px;
      letter-spacing: normal;
    }

    .mockup-wrapper {
      padding-top: 10px;
      height: auto;
    }

    .mockup-image-frame {
      max-width: 520px;
      width: 100%;
    }
  }
</style>
