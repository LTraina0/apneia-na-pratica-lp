<style>
  .cta-master-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 12px 20px;
    gap: 10px;
    position: relative;
    z-index: 2;
    max-width: 504px;
    width: 100%;
    margin-left: auto;
    margin-right: auto;
  }

  .price-anchor {
    font-family: var(--font-arimo), var(--font-primary);
    font-weight: 700;
    font-size: 24px;
    line-height: 38.4px;
    color: #1E293B;
    text-transform: uppercase;
    white-space: nowrap;
    text-align: center;
  }

  .price-green {
    color: #1FA34A;
    font-weight: 700;
  }

  .cta-inner-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    max-width: 464px;
    width: 100%;
  }

  .master-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--cta-gradient-green);
    border-radius: 8px;
    width: 464px;
    max-width: 100%;
    min-height: 80px;
    padding: 20px 48px;
    text-decoration: none;
    cursor: pointer;
    box-shadow: inset 0px 1.5px 0px 0px rgba(92, 255, 168, 0.51), 1px 17px 10px rgba(0, 11, 10, 0.2);
    transition: all var(--transition-fast);
    overflow: hidden;
    border: none;
  }

  .master-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.22), transparent);
    transition: left 0.5s ease;
  }

  .master-btn:hover {
    transform: translateY(-2px);
    box-shadow: inset 0px 1.5px 0px 0px rgba(92, 255, 168, 0.7), 1px 22px 16px rgba(0, 11, 10, 0.28);
    background: var(--cta-gradient-green-hover);
  }

  .master-btn:hover::before {
    left: 100%;
  }

  .master-btn:active {
    transform: translateY(1px);
  }

  .master-btn-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  .master-hand-icon {
    width: 29.5px;
    height: 35.2px;
    flex-shrink: 0;
  }

  .master-btn-text {
    font-family: var(--font-arimo), var(--font-primary);
    font-weight: 700;
    font-size: 22px;
    line-height: 24px;
    color: #FFFFFF;
    text-align: center;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .microcopy-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    color: #64748B;
  }

  .lock-icon {
    color: var(--color-teal-600);
    flex-shrink: 0;
  }

  .cta-microcopy {
    font-family: var(--font-arimo), var(--font-secondary);
    font-weight: 400;
    font-size: 14px;
    line-height: 18.2px;
    color: #64748B;
    text-align: center;
    margin: 0;
    max-width: 464px;
    width: 100%;
  }

  /* Mobile Overrides (Exact Node 136:3) */
  @media (max-width: 767px) {
    .cta-master-container {
      padding: 6px 20px;
      gap: 10px;
      max-width: 390px;
    }

    .price-anchor {
      font-size: 20px;
      line-height: 38.4px;
    }

    .cta-inner-wrapper {
      gap: 10px;
      max-width: 350px;
    }

    .master-btn {
      width: 100%;
      max-width: 350px;
      min-height: 72px;
      padding: 16px 20px;
    }

    .master-btn-content {
      gap: 14px;
    }

    .master-hand-icon {
      width: 28px;
      height: 33.5px;
    }

    .master-btn-text {
      font-size: 19px;
      line-height: 24px;
    }

    .cta-microcopy {
      font-size: 13px;
      line-height: 18.2px;
      max-width: 350px;
    }
  }
</style>

