---
interface Props {
  showPrice?: boolean;
  text?: string;
  href?: string;
  showIcon?: boolean;
  microcopy?: string;
  className?: string;
  target?: string;
}

const {
  showPrice = false,
  text = "QUERO ACESSAR AGORA",
  href = "#oferta",
  showIcon = true,
  microcopy = "Pagamento 100% seguro processado via Hotmart. Seus dados estão protegidos.",
  className = "",
  target = "_self"
} = Astro.props;
---

<div class={`cta-master-container ${className}`}>
  {showPrice && (
    <div class="price-anchor" data-node-id="131:1289">
      <span class="price-prefix">POR APENAS </span>
      <span class="price-green">R$47</span>
    </div>
  )}

  <div class="cta-inner-wrapper" data-node-id="131:1290">
    <a href={href} target={target} rel={target === '_blank' ? 'noopener noreferrer' : undefined} class="master-btn" data-node-id="131:1291">
      <div class="master-btn-content" data-node-id="135:1791">
        {showIcon && (
