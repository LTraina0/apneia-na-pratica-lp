<dialog id="lead-capture-modal" class="lead-dialog" aria-labelledby="lead-modal-title" aria-describedby="lead-modal-description">
  <form class="lead-modal" id="lead-capture-form" novalidate>
    <header class="lead-modal__header">
      <div class="lead-modal__title-row">
        <span class="lead-modal__spacer" aria-hidden="true"></span>
        <h2 id="lead-modal-title">Falta Pouco</h2>
        <button class="lead-modal__close" type="button" aria-label="Fechar formulário">
          <svg viewBox="0 0 10 10" aria-hidden="true"><path d="M2 2l6 6M8 2L2 8" /></svg>
        </button>
      </div>
      <p id="lead-modal-description">preencha seus dados para continuar para o pagamento</p>
    </header>
    <div class="lead-modal__fields">
      <label><span class="sr-only">Nome completo</span><input id="lead-name" name="name" type="text" autocomplete="name" placeholder="Digite seu nome completo" required /></label>
      <label><span class="sr-only">E-mail</span><input name="email" type="email" inputmode="email" autocomplete="email" placeholder="Seu melhor e-mail" required /></label>
      <label><span class="sr-only">WhatsApp com DDD</span><input name="whatsapp" type="tel" inputmode="tel" autocomplete="tel" placeholder="WhatsApp (com DDD)" maxlength="15" required /></label>
    </div>
    <button class="lead-modal__continue" type="submit">CONTINUAR</button>
  </form>
</dialog>

<script>
  const initializeLeadModal = () => {
    const dialog = document.querySelector<HTMLDialogElement>('#lead-capture-modal');
    const form = document.querySelector<HTMLFormElement>('#lead-capture-form');
    const closeButton = dialog?.querySelector<HTMLButtonElement>('.lead-modal__close');
    const nameInput = form?.elements.namedItem('name') as HTMLInputElement | null;
    const emailInput = form?.elements.namedItem('email') as HTMLInputElement | null;
    const phoneInput = form?.elements.namedItem('whatsapp') as HTMLInputElement | null;
    if (!dialog || !form || !closeButton || !nameInput || !emailInput || !phoneInput) return;
    let activeTrigger: HTMLAnchorElement | null = null;
    const closeModal = () => {
      dialog.close();
      document.body.classList.remove('lead-modal-open');
      activeTrigger?.focus();
    };
    const openModal = (trigger: HTMLAnchorElement) => {
      activeTrigger = trigger;
      form.reset();
      nameInput.setCustomValidity('');
      phoneInput.setCustomValidity('');
      document.body.classList.add('lead-modal-open');
      dialog.showModal();
      requestAnimationFrame(() => nameInput.focus());
    };
    const continueToCheckout = () => {
      if (!activeTrigger) return;
      const checkoutLink = document.createElement('a');
      checkoutLink.href = activeTrigger.href;
      checkoutLink.target = activeTrigger.target || '_self';
      checkoutLink.rel = activeTrigger.rel;
      checkoutLink.hidden = true;
      document.body.append(checkoutLink);
      closeModal();
      checkoutLink.click();
      checkoutLink.remove();
    };
    const formatPhone = (value: string) => {
      const digits = value.replace(/\D/g, '').slice(0, 11);
      if (digits.length <= 2) return digits;
      if (digits.length <= 6) return `(${digits.slice(0, 2)}) ${digits.slice(2)}`;
      if (digits.length <= 10) return `(${digits.slice(0, 2)}) ${digits.slice(2, 6)}-${digits.slice(6)}`;
      return `(${digits.slice(0, 2)}) ${digits.slice(2, 7)}-${digits.slice(7)}`;
    };
    document.querySelectorAll<HTMLAnchorElement>('[data-lead-capture="true"]').forEach((trigger) => {
      trigger.addEventListener('click', (event) => {
        event.preventDefault();
        openModal(trigger);
      });
    });
    phoneInput.addEventListener('input', () => {
      phoneInput.value = formatPhone(phoneInput.value);
      phoneInput.setCustomValidity('');
    });
    nameInput.addEventListener('input', () => nameInput.setCustomValidity(''));
    closeButton.addEventListener('click', closeModal);
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeModal();
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) closeModal();
    });
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const completeName = nameInput.value.trim().split(/\s+/).filter(Boolean).length >= 2;
      const phoneDigits = phoneInput.value.replace(/\D/g, '');
      nameInput.setCustomValidity(completeName ? '' : 'Digite seu nome completo.');
      phoneInput.setCustomValidity(phoneDigits.length >= 10 && phoneDigits.length <= 11 ? '' : 'Digite um WhatsApp válido com DDD.');
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const leadEvent = new CustomEvent('apneia:lead-submit', {
        bubbles: true,
        cancelable: true,
        detail: {
          lead: { name: nameInput.value.trim(), email: emailInput.value.trim(), whatsapp: phoneDigits },
          continueToCheckout,
        },
      });
      if (form.dispatchEvent(leadEvent)) continueToCheckout();
    });
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeLeadModal, { once: true });
  } else {
    initializeLeadModal();
  }
</script>

<style>
  .lead-dialog {
    width: 100vw; max-width: none; height: 100dvh; max-height: none; margin: 0; padding: 20px;
    overflow: auto; color: var(--color-text-body); background: transparent; border: 0;
  }
  .lead-dialog[open] { display: flex; align-items: center; justify-content: center; }
  .lead-dialog::backdrop { background: rgba(0, 0, 0, 0.74); -webkit-backdrop-filter: blur(4.45px); backdrop-filter: blur(4.45px); }
  .lead-modal {
    display: flex; flex: 0 0 auto; flex-direction: column; align-items: stretch; width: min(350px, 100%);
    padding: 24px; gap: 24px; background: linear-gradient(180deg, #FFFFFF 0%, #EEF6FF 100%); border-radius: 24px;
    box-shadow: 0 16px 16px rgba(0, 0, 0, 0.2); animation: lead-modal-in 180ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .lead-modal__header { display: flex; flex-direction: column; align-items: center; gap: 6px; width: 100%; }
  .lead-modal__title-row { display: flex; align-items: center; justify-content: space-between; width: 100%; }
  .lead-modal__spacer, .lead-modal__close { flex: 0 0 24px; width: 24px; height: 24px; }
  .lead-modal__header h2 {
    margin: 0; color: #0C2658; font-family: var(--font-primary); font-size: 24px; font-weight: 800;
    line-height: 28.8px; letter-spacing: 0; text-align: center; white-space: nowrap;
  }
  .lead-modal__close {
    display: inline-flex; align-items: center; justify-content: center; padding: 0; color: #64748B;
    background: #F1F5F9; border: 0; border-radius: 12px; cursor: pointer;
  }
  .lead-modal__close svg { width: 10px; height: 10px; }
  .lead-modal__close path { fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; }
  .lead-modal__header p {
    width: 100%; margin: 0; color: #64748B; font-family: var(--font-secondary); font-size: 13px;
    font-weight: 400; line-height: 18.2px; text-align: center;
  }
  .lead-modal__fields { display: flex; flex-direction: column; gap: 12px; width: 100%; }
  .lead-modal__fields label { display: block; width: 100%; }
  .lead-modal__fields input {
    display: block; width: 100%; min-width: 0; padding: 12px 16px; color: #1E293B;
    font-family: var(--font-arimo), var(--font-secondary); font-size: 14px; font-weight: 400;
    line-height: normal; background: transparent; border: 1px solid #E2E8F0; border-radius: 8px; outline: none;
  }
  .lead-modal__fields input::placeholder { color: #64748B; opacity: 1; }
  .lead-modal__fields input:focus { border-color: #0982A2; box-shadow: 0 0 0 3px rgba(24, 181, 200, 0.16); }
  .lead-modal__fields input:user-invalid { border-color: #B42318; }
  .lead-modal__continue {
    display: flex; align-items: center; justify-content: center; width: 100%; padding: 18.017px 33.69px;
    color: var(--color-white); font-family: var(--font-arimo), var(--font-primary); font-size: 16px;
    font-weight: 700; line-height: 13.613px; text-align: center; background: var(--cta-gradient-green);
    border: 0; border-radius: 4.584px; cursor: pointer;
    box-shadow: inset 0 0.859px 0 rgba(92,255,168,.51), .573px 9.74px 5.73px rgba(0,11,10,.2);
  }
  .lead-modal__close:focus-visible, .lead-modal__continue:focus-visible { outline: 3px solid var(--color-yellow-500); outline-offset: 3px; }
  .lead-modal__continue:hover { background: var(--cta-gradient-green-hover); }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }
  :global(body.lead-modal-open) { overflow: hidden; }
  @keyframes lead-modal-in {
    from { opacity: 0; transform: translateY(8px) scale(.985); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @media (min-width: 768px) {
    .lead-modal { width: 460px; padding: 31.543px; gap: 31.543px; box-shadow: 0 21.029px 21.029px rgba(0,0,0,.2); }
    .lead-modal__header { gap: 7.886px; }
    .lead-modal__spacer, .lead-modal__close { flex-basis: 31.543px; width: 31.543px; height: 31.543px; }
    .lead-modal__close svg { width: 13.143px; height: 13.143px; }
    .lead-modal__header h2 { font-size: 31.54px; line-height: 37.851px; }
    .lead-modal__header p { font-size: 17.09px; line-height: 23.92px; }
    .lead-modal__fields { gap: 15.771px; }
    .lead-modal__fields input { padding: 15.771px 21.029px; font-size: 18.4px; border-width: 1.314px; }
    .lead-modal__continue {
      padding: 23.68px 44.278px; font-size: 21.03px; line-height: 17.891px; border-radius: 6.024px;
      box-shadow: inset 0 1.13px 0 rgba(92,255,168,.51), .753px 12.802px 7.53px rgba(0,11,10,.2);
    }
  }
  @media (max-height: 520px) { .lead-dialog[open] { align-items: flex-start; } }
  @media (prefers-reduced-motion: reduce) { .lead-modal { animation: none; } }
</style>
