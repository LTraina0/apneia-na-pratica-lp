---
const looseItems = [
  "A conversa depende apenas do que o paciente relata espontaneamente.",
  "Uma resposta como “eu não ronco” pode encerrar a anamnese cedo demais.",
  "Cansaço, sono não reparador e sonolência ficam desconectados.",
  "Sinais e questionários acabam sendo vistos isoladamente.",
  "Fica menos claro quando aprofundar ou encaminhar."
];

const organizedItems = [
  "Faz perguntas mais direcionadas sobre sono e sintomas relacionados.",
  "Observa os sinais dentro do contexto clínico do paciente.",
  "Integra anamnese, avaliação e ferramentas de apoio.",
  "Evita transformar um sinal isolado em diagnóstico.",
  "Entende melhor quando a investigação merece avançar."
];
---

<section class="comparison-section" id="metodo">
  <div class="container text-center">

    <!-- H2 Principal -->
    <h2 class="comparison-title reveal">
      Reconhecer um sinal é diferente de saber o que fazer com ele.
    </h2>

    <!-- Subtítulo -->
    <p class="comparison-subtitle reveal delay-1">
      O <strong>Apneia na Prática</strong> ajuda você a sair de informações soltas e organizar uma investigação mais criteriosa durante a consulta.
    </p>

    <!-- Dois Painéis Lado a Lado (Clean / Editorial) -->
    <div class="panels-wrapper">
      
      <!-- Painel Esquerdo: Investigação Solta -->
      <div class="comparison-panel panel-loose reveal delay-2">
        <div class="panel-header">
          <span class="panel-badge badge-neutral">Cenário Desestruturado</span>
          <h3 class="panel-title">Quando a investigação fica solta</h3>
        </div>
        <ul class="panel-list">
          {looseItems.map((item) => (
            <li class="panel-list-item">
              <span class="icon-indicator indicator-loose" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9" />
                  <line x1="9" y1="12" x2="15" y2="12" />
                </svg>
              </span>
              <span class="item-text">{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Painel Direito: Investigação Organizada -->
      <div class="comparison-panel panel-organized reveal delay-3">
        <div class="panel-header">
          <span class="panel-badge badge-cyan">Método Clínico</span>
          <h3 class="panel-title">Quando você organiza a investigação</h3>
        </div>
        <ul class="panel-list">
          {organizedItems.map((item) => (
            <li class="panel-list-item">
              <span class="icon-indicator indicator-organized" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
              </span>
              <span class="item-text">{item}</span>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Conclusão e Fluxo Vetorial 100% Transparente do Processo -->
    <div class="process-container reveal delay-3">
      <p class="process-tagline">
        <strong>É esse raciocínio que você aprende no Apneia na Prática.</strong>
      </p>

      <!-- Fluxo Vetorial Contínuo 100% Transparente -->
      <div class="process-vector-flow">
        
        <!-- Step 1: Perguntar -->
        <div class="flow-step">
          <div class="flow-icon">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true">
              <path d="M8 12C8 9.79086 9.79086 8 12 8H28C30.2091 8 32 9.79086 32 12V22C32 24.2091 30.2091 26 28 26H16L10 31V26H12C9.79086 26 8 24.2091 8 22V12Z" stroke="#18B5C8" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="rgba(24, 181, 200, 0.08)"/>
              <line x1="14" y1="14" x2="26" y2="14" stroke="#18B5C8" stroke-width="2" stroke-linecap="round"/>
              <line x1="14" y1="18" x2="22" y2="18" stroke="#18B5C8" stroke-width="2" stroke-linecap="round"/>
              <path d="M32 16H35C37.2091 16 39 17.7909 39 20V27C39 29.2091 37.2091 31 35 31H33V35L29 31H24C22.68 31 21.5 30.37 20.73 29.4" stroke="#0982A2" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="#0982A2"/>
            </svg>
          </div>
          <div class="flow-meta">
            <span class="flow-num">01</span>
            <span class="flow-title">PERGUNTAR</span>
          </div>
        </div>

        <!-- Connector 1-2 -->
        <div class="flow-connector" aria-hidden="true">
          <svg width="52" height="16" viewBox="0 0 52 16" fill="none">
            <line x1="2" y1="8" x2="42" y2="8" stroke="#18B5C8" stroke-width="2" stroke-dasharray="4 4"/>
            <polyline points="38 4 44 8 38 12" stroke="#18B5C8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>

        <!-- Step 2: Observar -->
        <div class="flow-step">
          <div class="flow-icon">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true">
              <path d="M6 24C6 24 13 12 24 12C35 12 42 24 42 24C42 24 35 36 24 36C13 36 6 24 6 24Z" stroke="#18B5C8" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="rgba(24, 181, 200, 0.08)"/>
              <circle cx="24" cy="24" r="6.5" stroke="#18B5C8" stroke-width="2.5" fill="#18B5C8"/>
              <circle cx="26" cy="22" r="2" fill="#FFFFFF"/>
            </svg>
          </div>
          <div class="flow-meta">
            <span class="flow-num">02</span>
            <span class="flow-title">OBSERVAR</span>
          </div>
        </div>

        <!-- Connector 2-3 -->
        <div class="flow-connector" aria-hidden="true">
          <svg width="52" height="16" viewBox="0 0 52 16" fill="none">
            <line x1="2" y1="8" x2="42" y2="8" stroke="#18B5C8" stroke-width="2" stroke-dasharray="4 4"/>
            <polyline points="38 4 44 8 38 12" stroke="#18B5C8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>

        <!-- Step 3: Organizar -->
        <div class="flow-step">
          <div class="flow-icon">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true">
              <rect x="12" y="10" width="24" height="30" rx="4" stroke="#18B5C8" stroke-width="2.5" fill="rgba(24, 181, 200, 0.08)"/>
              <path d="M18 10V8C18 6.89543 18.8954 6 20 6H28C29.1046 6 30 6.89543 30 8V10" stroke="#18B5C8" stroke-width="2.5"/>
              <circle cx="24" cy="9" r="1.5" fill="#18B5C8"/>
              <path d="M17 18L20 21L27 15" stroke="#18B5C8" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <line x1="21" y1="26" x2="30" y2="26" stroke="#18B5C8" stroke-width="2" stroke-linecap="round"/>
              <path d="M17 25L19 27" stroke="#18B5C8" stroke-width="2" stroke-linecap="round"/>
              <line x1="21" y1="32" x2="30" y2="32" stroke="#18B5C8" stroke-width="2" stroke-linecap="round"/>
              <path d="M17 31L19 33" stroke="#18B5C8" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="flow-meta">
            <span class="flow-num">03</span>
            <span class="flow-title">ORGANIZAR</span>
          </div>
        </div>

        <!-- Connector 3-4 -->
        <div class="flow-connector" aria-hidden="true">
          <svg width="52" height="16" viewBox="0 0 52 16" fill="none">
            <line x1="2" y1="8" x2="42" y2="8" stroke="#18B5C8" stroke-width="2" stroke-dasharray="4 4"/>
            <polyline points="38 4 44 8 38 12" stroke="#18B5C8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>

        <!-- Step 4: Decidir o próximo passo -->
        <div class="flow-step">
          <div class="flow-icon">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true">
              <circle cx="24" cy="24" r="16" stroke="#18B5C8" stroke-width="2.5" fill="rgba(24, 181, 200, 0.08)"/>
              <path d="M16 27L32 16L27 32L23 25L16 27Z" fill="#18B5C8" stroke="#18B5C8" stroke-width="1.5" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="flow-meta">
            <span class="flow-num">04</span>
            <span class="flow-title">DECIDIR O PRÓXIMO PASSO</span>
          </div>
        </div>

      </div>
    </div>

    <!-- CTA Clean e Premium -->
    <div class="cta-wrapper reveal delay-4">
      <a href="#oferta" class="btn-primary comparison-cta">
        QUERO APRENDER ESSE PROCESSO
      </a>
    </div>

  </div>
</section>

<style>
  .comparison-section {
    padding-top: clamp(48px, 6vw, 76px);
    padding-bottom: clamp(48px, 6vw, 76px);
    background-color: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    position: relative;
  }

  .comparison-title {
    max-width: 820px;
    margin: 0 auto clamp(12px, 1.6vw, 16px);
    color: var(--color-navy-700);
  }

  .comparison-subtitle {
    max-width: 700px;
    margin: 0 auto clamp(28px, 3.5vw, 40px);
    font-size: clamp(15px, 1.1vw, 16.5px);
    line-height: 1.55;
    color: var(--color-text-body);
  }

  .comparison-subtitle strong {
    font-weight: 700;
    color: var(--color-navy-700);
  }

  /* Painéis Lado a Lado - Clean / Flat / Editorial */
  .panels-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
    margin-bottom: clamp(36px, 4.5vw, 48px);
    text-align: left;
  }

  .comparison-panel {
    border-radius: var(--radius-card);
    padding: clamp(24px, 3vw, 32px) clamp(20px, 2.5vw, 28px);
    display: flex;
    flex-direction: column;
    box-shadow: none;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .comparison-panel:hover {
    transform: translateY(-2px);
  }

  .panel-loose {
    background-color: var(--color-blue-gray-50);
    border: 1px solid var(--color-blue-gray-100);
  }

  .panel-organized {
    background-color: #FFFFFF;
    border: 2px solid var(--color-cyan-500);
    box-shadow: 0 8px 24px rgba(24, 181, 200, 0.1);
  }

  .panel-header {
    margin-bottom: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(226, 232, 240, 0.8);
  }

  .panel-badge {
    display: inline-block;
    font-family: var(--font-primary);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 3px 9px;
    border-radius: 6px;
    margin-bottom: 8px;
  }

  .badge-neutral {
    background-color: var(--color-blue-gray-100);
    color: var(--color-text-muted);
  }

  .badge-cyan {
    background: var(--badge-cyan-gradient);
    color: var(--color-teal-600);
    border: 1px solid rgba(24, 181, 200, 0.25);
  }

  .panel-title {
    font-size: clamp(18px, 1.8vw, 21px);
    font-weight: 700;
    color: var(--color-navy-700);
  }

  .panel-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 13px;
  }

  .panel-list-item {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-text-body);
  }

  .icon-indicator {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
  }

  .indicator-loose {
    background-color: var(--color-blue-gray-100);
    color: var(--color-text-muted);
  }

  .indicator-organized {
    background-color: rgba(24, 181, 200, 0.15);
    color: var(--color-cyan-500);
  }

  .item-text {
    flex: 1;
  }

  /* Process Vector Flow */
  .process-container {
    max-width: 860px;
    margin: 0 auto clamp(24px, 3.5vw, 36px);
  }

  .process-tagline {
    font-size: clamp(15px, 1.15vw, 17px);
    color: var(--color-navy-700);
    margin-bottom: 24px;
  }

  .process-vector-flow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 820px;
    margin: 0 auto clamp(20px, 3vw, 32px);
    background: transparent;
    padding: 0;
  }

  .flow-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex: 1;
    max-width: 170px;
    transition: transform var(--transition-fast);
  }

  .flow-step:hover {
    transform: translateY(-2px);
  }

  .flow-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
  }

  .flow-meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }

  .flow-num {
    font-family: var(--font-primary);
    font-size: 15px;
    font-weight: 800;
    color: var(--color-cyan-500);
    letter-spacing: -0.01em;
  }

  .flow-title {
    font-family: var(--font-primary);
    font-size: 12.5px;
    font-weight: 800;
    color: var(--color-navy-700);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.25;
  }

  .flow-connector {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 0 4px;
    margin-bottom: 30px;
  }

  /* CTA Clean & Premium */
  .cta-wrapper {
    display: flex;
    justify-content: center;
  }

  .comparison-cta {
    width: 100%;
    max-width: 380px;
  }

  @media (max-width: 860px) {
    .panels-wrapper {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .process-vector-flow {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px 16px;
    }

    .flow-connector {
      display: none;
    }

    .flow-step {
      max-width: 100%;
    }

    .comparison-cta {
      max-width: 100%;
    }
  }

  @media (max-width: 480px) {
    .process-vector-flow {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
